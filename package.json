{
  "name": "rinconcito-verde-v1",
  "version": "0.1.0",
  "description": "Base independiente de demostración — SPEC-001",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "lint": "eslint .",
    "validate:catalog": "node scripts/validate-catalog.ts",
    "test": "vitest run",
    "build": "npm run validate:catalog && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy": "node scripts/deploy.mjs",
    "build:backend": "npm --prefix functions run build",
    "emulators": "npm run build:backend && firebase emulators:start --project demo-rinconcito-verde --only auth,firestore,storage,functions",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:18080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099 node scripts/seed-emulators.mjs",
    "test:emulators": "node scripts/test-emulators.mjs",
    "test:admin": "node scripts/test-emulators.mjs --ui",
    "deploy:online": "node scripts/deploy-online.ts",
    "configure:online": "node scripts/configure-online.ts",
    "verify:online": "node scripts/verify-online.ts",
    "release:online": "npm run deploy:online && npm run verify:online"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@mui/material": "9.5.0",
    "firebase": "^13.3.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "jsdom": "31.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
