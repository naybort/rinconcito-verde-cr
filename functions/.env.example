# Backend only. Copy to functions/.env.local and edit privately.
# Disabled by default. Both flags are required for real OpenAI in emulators.
AI_ENABLED=false
AI_EMULATOR_OPENAI=false
OPENAI_LOCAL_API_KEY=
# Choose model IDs supported by your API account; no model is assumed.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
