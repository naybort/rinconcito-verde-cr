# Public Firebase web configuration only. Copy to .env.production.local without overwriting an existing file.
# Get actual values from Firebase Console > Project settings > Your apps. No service-account JSON or AI keys.
VITE_FIREBASE_MODE=cloud
VITE_FIREBASE_PROJECT_ID=rinconcito-verde-cr
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rinconcito-verde-cr.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=rinconcito-verde-cr.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=us-central1
# Must match the provider registered for this app in Firebase App Check.
VITE_FIREBASE_APPCHECK_PROVIDER=recaptcha-enterprise
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Backend model IDs only. OPENAI_API_KEY must be stored in Secret Manager.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
