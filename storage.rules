rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function staff() { return request.auth != null && request.auth.token.role in ['admin','editor'] && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role == request.auth.token.role; }
  match /originals/{uid}/{plantId}/{file} {
   allow read: if staff();
   allow create: if resource == null && staff() && request.auth.uid == uid && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)') && file.matches('[a-z0-9-]+');
   allow update, delete: if false;
  }
  match /proposals/{plantId}/{file} { allow read: if staff(); allow write: if false; }
  match /public/{plantId}/{file} { allow read: if true; allow write: if false; }
 }
}
